---
import Icon from "./Icon.astro";
import { nav, profile } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-surface-2">
  <div class="mx-auto max-w-6xl px-5 py-14 md:px-8">
    <div class="grid gap-8 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-foreground text-background text-xs font-semibold"
          >
            {profile.initials}
          </span>
          <span class="font-semibold tracking-tight">{profile.name}</span>
        </a>
        <p class="mt-3 max-w-sm text-sm text-muted-foreground">
          Full-Stack Developer building production web and mobile products end to end. Top
          Rated on Upwork · 100% Job Success.
        </p>
      </div>
      <div class="md:col-span-3">
        <p class="text-sm font-semibold">Pages</p>
        <div class="mt-2 flex flex-col gap-1.5 text-sm text-muted-foreground">
          <a href="/" class="hover:text-foreground">Home</a>
          {
            nav.map((item) => (
              <a href={item.href} class="hover:text-foreground">
                {item.label}
              </a>
            ))
          }
          <a href="/contact" class="hover:text-foreground">Contact</a>
        </div>
      </div>
      <div class="md:col-span-4">
        <p class="text-sm font-semibold">Connect</p>
        <p class="mt-2 flex items-center gap-2 text-sm text-muted-foreground">
          <Icon name="MapPin" class="h-4 w-4" />
          {profile.location}
        </p>
        <div class="mt-3 flex gap-2">
          <a
            href={profile.github}
            target="_blank"
            rel="noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-border bg-card text-foreground transition-all hover:elevation-1 hover:text-primary"
            aria-label="GitHub"
          >
            <Icon name="Github" class="h-4 w-4" />
          </a>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-border bg-card text-foreground transition-all hover:elevation-1 hover:text-primary"
            aria-label="LinkedIn"
          >
            <Icon name="Linkedin" class="h-4 w-4" />
          </a>
          <a
            href={profile.upwork}
            target="_blank"
            rel="noreferrer"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-border bg-card text-foreground transition-all hover:elevation-1 hover:text-primary"
            aria-label="Upwork"
          >
            <span class="text-xs font-bold">Up</span>
          </a>
        </div>
      </div>
    </div>
    <div
      class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-border pt-6 text-sm text-muted-foreground md:flex-row"
    >
      <span>© {year} {profile.fullName}. All rights reserved.</span>
      <span>Built with production-grade standards · v3.0</span>
    </div>
  </div>
</footer>
