---
import Icon from "./Icon.astro";
import { profile, projectTypes } from "../data/site";

const fieldClass =
  "w-full rounded-xl border border-input bg-background/60 px-4 py-3 text-foreground outline-none transition-colors placeholder:text-muted-foreground/50 focus:border-primary focus:ring-2 focus:ring-primary/20";
---

<section id="contact" class="relative overflow-hidden">
  <div class="absolute inset-0 -z-10 hero-glow opacity-60"></div>
  <div class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-36">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="text-[13px] font-semibold uppercase tracking-wider text-primary">Contact</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-[-0.02em] md:text-5xl">
          Let's build something.
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
          Tell me what you're building. I'll read it, think about it, and respond directly —
          no account managers, no templates.
        </p>
        <div class="mt-8 space-y-3">
          <a
            href={profile.upwork}
            target="_blank"
            rel="noreferrer"
            class="flex items-center justify-between rounded-2xl border border-border/70 glass-card p-4 transition-all hover:elevation-2"
          >
            <span class="font-medium">Upwork Profile</span>
            <span class="text-sm text-primary">Top Rated · 100% JSS →</span>
          </a>
          <a
            href={profile.github}
            target="_blank"
            rel="noreferrer"
            class="flex items-center justify-between rounded-2xl border border-border/70 glass-card p-4 transition-all hover:elevation-2"
          >
            <span class="font-medium">GitHub</span>
            <span class="text-sm text-primary">218 repos →</span>
          </a>
        </div>
      </div>

      <div class="md:col-span-7">
        <div
          id="contact-success"
          class="glass-card hidden flex-col items-center justify-center rounded-[2rem] border border-border/70 p-10 text-center elevation-2 md:p-16"
        >
          <div class="flex h-16 w-16 items-center justify-center rounded-full bg-green-500/15">
            <Icon name="CircleCheck" class="h-8 w-8 text-green-500" />
          </div>
          <h3 class="mt-5 text-2xl font-semibold tracking-tight">Message sent</h3>
          <p class="mt-2 max-w-sm text-muted-foreground">
            Your inquiry has been logged. I'll read it and respond directly — typically within
            24 hours.
          </p>
          <button
            id="send-another"
            type="button"
            class="mt-6 rounded-full border border-border px-6 py-2.5 text-sm font-semibold text-foreground transition-all hover:bg-muted"
          >
            Send another
          </button>
        </div>

        <form
          id="contact-form"
          class="glass-card rounded-[2rem] border border-border/70 p-6 elevation-2 md:p-8"
        >
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-foreground">
                Name <span class="text-primary">*</span>
              </span>
              <input
                name="name"
                required
                placeholder="Your name"
                class={fieldClass}
              />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-foreground">
                Email <span class="text-primary">*</span>
              </span>
              <input
                type="email"
                name="email"
                required
                placeholder="you@domain.com"
                class={fieldClass}
              />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-foreground">
                Company (optional)
              </span>
              <input name="company" placeholder="Company / project" class={fieldClass} />
            </label>
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-foreground">
                Project type
              </span>
              <select name="project_type" class={fieldClass}>
                {
                  projectTypes.map((type) => (
                    <option value={type} selected={type === "Full-Stack Build"}>
                      {type}
                    </option>
                  ))
                }
              </select>
            </label>
          </div>
          <div class="mt-5">
            <label class="block">
              <span class="mb-1.5 block text-sm font-medium text-foreground">
                Brief <span class="text-primary">*</span>
              </span>
              <textarea
                name="message"
                required
                rows="5"
                placeholder="Describe the system you want to build — scope, timeline, what success looks like..."
                class={`resize-none ${fieldClass}`}
              ></textarea>
            </label>
          </div>
          <p
            id="contact-error"
            class="mt-4 hidden rounded-xl bg-destructive/10 px-4 py-3 text-sm text-destructive"
          >
          </p>
          <button
            type="submit"
            id="contact-submit"
            class="mt-6 flex w-full items-center justify-center gap-2 rounded-full bg-primary px-6 py-3.5 text-[15px] font-semibold text-primary-foreground transition-all hover:brightness-110 active:scale-[0.98] disabled:opacity-60"
          >
            <span id="submit-idle" class="inline-flex items-center gap-2">
              Send message
              <Icon name="Send" class="h-4 w-4" />
            </span>
            <span id="submit-loading" class="hidden inline-flex items-center gap-2">
              <Icon name="LoaderCircle" class="h-4 w-4 animate-spin" />
              Sending...
            </span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { ConvexHttpClient } from "convex/browser";
  import { api } from "../../convex/_generated/api";

  const convexUrl = import.meta.env.PUBLIC_CONVEX_URL as string | undefined;
  const client = convexUrl ? new ConvexHttpClient(convexUrl) : null;

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const success = document.getElementById("contact-success");
  const errorEl = document.getElementById("contact-error");
  const submit = document.getElementById("contact-submit") as HTMLButtonElement | null;
  const idle = document.getElementById("submit-idle");
  const loading = document.getElementById("submit-loading");
  const again = document.getElementById("send-another");

  function setLoading(on: boolean) {
    if (!submit) return;
    submit.disabled = on;
    idle?.classList.toggle("hidden", on);
    loading?.classList.toggle("hidden", !on);
  }

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  }

  function hideError() {
    errorEl?.classList.add("hidden");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    hideError();
    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const company = String(data.get("company") ?? "").trim();
    const project_type = String(data.get("project_type") ?? "Full-Stack Build");
    const message = String(data.get("message") ?? "").trim();
    if (name.length < 2 || message.length < 10 || !email.includes("@")) {
      showError(
        "Please enter a valid name, email, and a message of at least 10 characters.",
      );
      return;
    }
    if (!client) {
      showError("Database is not connected. Please try again or reach out on Upwork.");
      return;
    }
    setLoading(true);
    try {
      await client.mutation(api.inquiries.create, {
        name,
        email,
        company: company || undefined,
        project_type,
        message,
      });
      form.classList.add("hidden");
      success?.classList.remove("hidden");
      success?.classList.add("flex", "animate-fade-up");
      form.reset();
    } catch {
      showError("Something went wrong. Please try again or reach out on Upwork.");
    } finally {
      setLoading(false);
    }
  });

  again?.addEventListener("click", () => {
    success?.classList.add("hidden");
    success?.classList.remove("flex");
    form?.classList.remove("hidden");
  });
</script>
