---
import Icon from "./Icon.astro";
import { profile, stats } from "../data/site";
---

<section id="home" class="relative overflow-hidden">
  <div class="absolute inset-0 -z-10 hero-glow"></div>
  <div class="mx-auto max-w-6xl px-5 pb-16 pt-16 md:px-8 md:pb-24 md:pt-24">
    <div class="grid items-center gap-14 md:grid-cols-[1.35fr_1fr]">
      <div>
        <div
          class="animate-fade-up inline-flex items-center gap-2 rounded-full border border-border bg-card/80 px-3 py-1.5 text-xs font-medium backdrop-blur elevation-1"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-60"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-green-500"></span>
          </span>
          <span class="text-muted-foreground">Top Rated · Available for work</span>
        </div>

        <h1
          class="animate-fade-up mt-6 text-5xl font-semibold leading-[1.02] tracking-[-0.03em] md:text-7xl"
          style="animation-delay:.05s"
        >
          Full-Stack Developer
          <span
            class="block bg-gradient-to-r from-primary to-tertiary bg-clip-text text-transparent"
          >
            for SaaS founders.
          </span>
        </h1>

        <p
          class="animate-fade-up mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl"
          style="animation-delay:.12s"
        >
          I'm Muhammad Bilal Mohib — I build production web and mobile products end to end
          with Next.js, TypeScript, Supabase/Postgres, and Stripe. Platforms that take
          payments correctly and stay fast under real traffic.
        </p>

        <div
          class="animate-fade-up mt-9 flex flex-wrap items-center gap-3"
          style="animation-delay:.18s"
        >
          <a
            href="/contact"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-[15px] font-semibold text-primary-foreground transition-all hover:brightness-110 active:scale-95"
          >
            Start a project
            <Icon name="ArrowRight" class="h-4 w-4" />
          </a>
          <a
            href="/work"
            class="inline-flex items-center gap-2 rounded-full border border-border bg-card/60 px-6 py-3 text-[15px] font-semibold text-foreground backdrop-blur transition-all hover:bg-muted active:scale-95"
          >
            View work
          </a>
          <a
            href={profile.github}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 text-[15px] font-semibold text-muted-foreground transition-colors hover:text-foreground"
          >
            <Icon name="Github" class="h-4 w-4" />
            GitHub
          </a>
        </div>
      </div>

      <div class="animate-fade-up relative mx-auto w-full max-w-xs" style="animation-delay:.2s">
        <div
          class="glass-card rounded-[2rem] border border-border/70 p-6 text-center elevation-3"
        >
          <div class="relative mx-auto h-28 w-28">
            <img
              src={profile.avatar}
              alt={profile.fullName}
              width="112"
              height="112"
              class="h-28 w-28 rounded-full object-cover ring-2 ring-primary/30"
            />
            <span
              class="absolute bottom-1 right-1 flex h-7 w-7 items-center justify-center rounded-full border-2 border-background bg-green-500"
            >
              <Icon name="CircleCheck" class="h-4 w-4 text-white" />
            </span>
          </div>
          <h3 class="mt-4 text-lg font-semibold tracking-tight">{profile.fullName}</h3>
          <p class="text-sm text-muted-foreground">{profile.location}</p>
          <div class="mt-3 flex items-center justify-center gap-1.5">
            <Icon name="Star" class="h-4 w-4 fill-amber-400 text-amber-400" />
            <span class="font-semibold">{profile.rating}</span>
            <span class="text-sm text-muted-foreground">· {profile.reviews} reviews</span>
          </div>
          <div class="mt-4 rounded-2xl bg-primary-container px-4 py-2.5">
            <div class="text-xs font-medium text-on-primary-container">Hourly rate</div>
            <div class="text-xl font-bold text-on-primary-container">{profile.rate}</div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="animate-fade-up mt-16 grid grid-cols-2 gap-4 md:grid-cols-4"
      style="animation-delay:.28s"
    >
      {
        stats.map((stat) => (
          <div class="rounded-2xl border border-border/70 bg-card/60 p-5 backdrop-blur transition-all hover:elevation-2">
            <Icon name={stat.icon} class="h-5 w-5 text-primary" />
            <div class="mt-3 text-2xl font-semibold tracking-tight md:text-3xl">
              {stat.value}
            </div>
            <div class="mt-0.5 text-[13px] text-muted-foreground">{stat.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
