---
import Icon from "./Icon.astro";
import BrowserPreview from "./BrowserPreview.astro";
import { featuredWork } from "../data/site";
---

<section class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-32">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-[13px] font-semibold uppercase tracking-wider text-primary">
        Featured work
      </p>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-0.02em] md:text-5xl">
        Live products. Real traffic.
      </h2>
      <p class="mt-3 max-w-xl text-lg text-muted-foreground">
        Two production sites I want clients to see first — cinematic SaaS marketing and
        an AI platform that sells itself on the first screen.
      </p>
    </div>
    <a
      href="/work"
      class="inline-flex items-center gap-2 text-[15px] font-semibold text-primary hover:underline"
    >
      All case studies
      <Icon name="ArrowRight" class="h-4 w-4" />
    </a>
  </div>

  <div class="mt-14 grid gap-16">
    {
      featuredWork.map((project, index) => (
        <article
          data-reveal
          data-delay={String(index * 0.08)}
          class="grid items-center gap-8 md:grid-cols-12"
        >
          <div class:list={["md:col-span-7", index % 2 === 1 && "md:order-2"]}>
            {project.preview && project.url && (
              <BrowserPreview
                src={project.preview}
                url={project.url}
                alt={`${project.title} live preview`}
                href={`/work/${project.slug}`}
                large
              />
            )}
          </div>
          <div class:list={["md:col-span-5", index % 2 === 1 && "md:order-1"]}>
            <p class="text-[13px] font-semibold uppercase tracking-wider text-primary">
              {project.client}
            </p>
            <h3 class="mt-2 text-2xl font-semibold tracking-tight md:text-3xl">
              {project.title}
            </h3>
            <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">
              {project.summary}
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {project.stack.slice(0, 4).map((tech) => (
                <span class="rounded-lg bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground">
                  {tech}
                </span>
              ))}
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
              <a
                href={`/work/${project.slug}`}
                class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground transition-all hover:brightness-110"
              >
                Case study
                <Icon name="ArrowRight" class="h-4 w-4" />
              </a>
              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-semibold text-foreground transition-all hover:bg-muted"
                >
                  Live site
                  <Icon name="ExternalLink" class="h-4 w-4" />
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
