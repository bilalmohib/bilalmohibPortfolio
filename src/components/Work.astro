---
import Icon from "./Icon.astro";
import BrowserPreview from "./BrowserPreview.astro";
import { featuredWork, profile, work } from "../data/site";

const rest = work.filter((project) => !project.featured);
---

<section id="work" class="bg-surface-2 border-y border-border">
  <div class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-36">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-[13px] font-semibold uppercase tracking-wider text-primary">
          Case Studies
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-[-0.02em] md:text-5xl">
          Selected work that ships
        </h1>
        <p class="mt-3 max-w-2xl text-lg text-muted-foreground">
          Start with the two live products. Then browse engagements from Upwork — 53 jobs,
          100% Job Success.
        </p>
      </div>
      <a
        href={profile.upwork}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-2 text-[15px] font-semibold text-primary hover:underline"
      >
        View all 53 jobs
        <Icon name="ExternalLink" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-14 grid gap-10">
      {
        featuredWork.map((project) => (
          <article class="overflow-hidden rounded-[2rem] border border-border/70 bg-card p-5 md:p-8">
            <div class="grid items-center gap-8 md:grid-cols-12">
              <div class="md:col-span-7">
                {project.preview && project.url && (
                  <BrowserPreview
                    src={project.preview}
                    url={project.url}
                    alt={`${project.title} preview`}
                    href={`/work/${project.slug}`}
                    large
                  />
                )}
              </div>
              <div class="md:col-span-5">
                <div class="flex items-center justify-between">
                  <span class="flex items-center gap-1 rounded-full bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-600 dark:text-amber-400">
                    <Icon name="Star" class="h-3 w-3 fill-amber-500 text-amber-500" />
                    {project.rating.toFixed(1)} · Featured
                  </span>
                  <span class="text-xs text-muted-foreground">{project.period}</span>
                </div>
                <h2 class="mt-4 text-2xl font-semibold tracking-tight">{project.title}</h2>
                <p class="mt-1 text-sm text-muted-foreground">{project.client}</p>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                  {project.summary}
                </p>
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {project.stack.map((tech) => (
                    <span class="rounded-lg bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                      {tech}
                    </span>
                  ))}
                </div>
                <div class="mt-6 flex flex-wrap gap-3">
                  <a
                    href={`/work/${project.slug}`}
                    class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:brightness-110"
                  >
                    Open case study
                    <Icon name="ArrowRight" class="h-4 w-4" />
                  </a>
                  {project.url && (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-semibold hover:bg-muted"
                    >
                      {project.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                      <Icon name="ExternalLink" class="h-4 w-4" />
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <h2 class="mt-16 text-xl font-semibold tracking-tight md:text-2xl">More engagements</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((job, index) => (
          <a
            href={`/work/${job.slug}`}
            data-reveal
            data-delay={String((index % 3) * 0.07)}
            class="group flex flex-col rounded-3xl border border-border/70 bg-card p-6 transition-all hover:-translate-y-1 hover:elevation-3"
          >
            <div class="flex items-center justify-between">
              <span class="flex items-center gap-1 rounded-full bg-amber-500/10 px-2.5 py-1 text-xs font-semibold text-amber-600 dark:text-amber-400">
                <Icon name="Star" class="h-3 w-3 fill-amber-500 text-amber-500" />
                {job.rating.toFixed(1)}
              </span>
              <span class="flex items-center gap-1 text-xs text-muted-foreground">
                <Icon name="Calendar" class="h-3 w-3" />
                {job.period}
              </span>
            </div>
            <h3 class="mt-4 font-semibold leading-snug tracking-tight transition-colors group-hover:text-primary">
              {job.title}
            </h3>
            <p class="mt-1 text-sm text-muted-foreground">{job.client}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{job.summary}</p>
            <div class="mt-auto flex flex-wrap gap-1.5 pt-5">
              {job.stack.map((tech) => (
                <span class="rounded-lg bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                  {tech}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
