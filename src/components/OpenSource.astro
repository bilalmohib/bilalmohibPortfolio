---
import Icon from "./Icon.astro";
import {
  fallbackRepos,
  fetchGithubRepos,
  languageColors,
  profile,
  type Repo,
} from "../data/site";

let repos: Repo[] = fallbackRepos;
try {
  repos = await fetchGithubRepos();
} catch {
  repos = fallbackRepos;
}

const colorOf = (language: string | null) =>
  (language && languageColors[language]) || "#6e7681";
---

<section id="open-source" class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-36">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-[13px] font-semibold uppercase tracking-wider text-primary">
        Open Source
      </p>
      <h1 class="mt-3 text-3xl font-semibold tracking-[-0.02em] md:text-5xl">
        Live from GitHub
      </h1>
      <p class="mt-2 text-muted-foreground">
        Fetched in real time from the GitHub API · {profile.publicRepos} public repos
      </p>
    </div>
    <button
      id="refresh-repos"
      type="button"
      class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-all hover:elevation-1 hover:bg-muted"
    >
      <Icon name="RefreshCw" class="h-4 w-4" />
      Refresh
    </button>
  </div>

  <div id="repo-grid" class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      repos.map((repo, index) => (
        <a
          href={repo.html_url}
          target="_blank"
          rel="noreferrer"
          data-reveal
          data-delay={String((index % 4) * 0.05)}
          class="group flex flex-col rounded-2xl border border-border/70 bg-card p-5 transition-all hover:-translate-y-1 hover:elevation-3"
        >
          <div class="flex items-start justify-between gap-2">
            <h3 class="font-mono text-sm font-semibold text-primary break-all leading-snug">
              {repo.name}
            </h3>
            <Icon
              name="ExternalLink"
              class="h-4 w-4 shrink-0 text-muted-foreground transition-colors group-hover:text-primary"
            />
          </div>
          <p class="mt-2 line-clamp-3 min-h-[3.75rem] text-sm leading-relaxed text-muted-foreground">
            {repo.description || "No description provided."}
          </p>
          <div class="mt-auto flex items-center justify-between pt-4 text-xs text-muted-foreground">
            <span class="flex items-center gap-1.5">
              <span
                class="h-2.5 w-2.5 rounded-full"
                style={`background:${colorOf(repo.language)}`}
              />
              {repo.language || "—"}
            </span>
            <span class="flex items-center gap-3">
              <span class="flex items-center gap-1">
                <Icon name="Star" class="h-3 w-3" />
                {repo.stargazers_count}
              </span>
              <span class="flex items-center gap-1">
                <Icon name="GitFork" class="h-3 w-3" />
                {repo.forks_count}
              </span>
            </span>
          </div>
        </a>
      ))
    }
  </div>

  <div class="mt-10 text-center">
    <a
      href={profile.github}
      target="_blank"
      rel="noreferrer"
      class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-6 py-3 text-[15px] font-semibold text-foreground transition-all hover:elevation-1 hover:bg-muted"
    >
      View all {profile.publicRepos} repositories
      <Icon name="ExternalLink" class="h-4 w-4" />
    </a>
  </div>
</section>

<script>
  import { fallbackRepos, languageColors, type Repo } from "../data/site";

  const colors: Record<string, string> = languageColors;

  function escapeHtml(value: string) {
    return value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
  }

  function colorOf(language: string | null) {
    return (language && colors[language]) || "#6e7681";
  }

  function card(repo: Repo, index: number) {
    const delay = (index % 4) * 0.05;
    return `<a href="${escapeHtml(repo.html_url)}" target="_blank" rel="noreferrer" class="group flex flex-col rounded-2xl border border-border/70 bg-card p-5 transition-all hover:-translate-y-1 hover:elevation-3 animate-fade-up" style="animation-delay:${delay}s">
      <div class="flex items-start justify-between gap-2">
        <h3 class="font-mono text-sm font-semibold text-primary break-all leading-snug">${escapeHtml(repo.name)}</h3>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0 text-muted-foreground transition-colors group-hover:text-primary" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
      </div>
      <p class="mt-2 line-clamp-3 min-h-[3.75rem] text-sm leading-relaxed text-muted-foreground">${escapeHtml(repo.description || "No description provided.")}</p>
      <div class="mt-auto flex items-center justify-between pt-4 text-xs text-muted-foreground">
        <span class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full" style="background:${colorOf(repo.language)}"></span>
          ${escapeHtml(repo.language || "—")}
        </span>
        <span class="flex items-center gap-3">
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
            ${repo.stargazers_count}
          </span>
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3" aria-hidden="true"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"/><path d="M12 12v3"/></svg>
            ${repo.forks_count}
          </span>
        </span>
      </div>
    </a>`;
  }

  const button = document.getElementById("refresh-repos");
  const grid = document.getElementById("repo-grid");
  const icon = button?.querySelector("svg");

  async function loadRepos() {
    if (!grid || !button) return;
    icon?.classList.add("animate-spin");
    try {
      const res = await fetch(
        "https://api.github.com/users/bilalmohib/repos?sort=updated&per_page=100&type=owner",
        { headers: { Accept: "application/vnd.github+json" } },
      );
      if (!res.ok) throw new Error("rate-limited");
      const data = (await res.json()) as Array<Repo & { fork?: boolean }>;
      const repos = data
        .filter((repo) => !repo.fork)
        .sort((a, b) => b.stargazers_count - a.stargazers_count)
        .slice(0, 8);
      grid.innerHTML = repos.map((repo, index) => card(repo, index)).join("");
    } catch {
      grid.innerHTML = fallbackRepos.map((repo, index) => card(repo, index)).join("");
    } finally {
      icon?.classList.remove("animate-spin");
    }
  }

  button?.addEventListener("click", () => {
    void loadRepos();
  });
</script>
