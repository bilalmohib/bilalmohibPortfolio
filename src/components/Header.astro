---
import Icon from "./Icon.astro";
import { nav, profile } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-transparent transition-all duration-500"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5 md:px-8">
    <a href="/" class="flex items-center gap-2.5">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-lg bg-foreground text-background text-xs font-semibold"
      >
        {profile.initials}
      </span>
      <span class="hidden text-[15px] font-semibold tracking-tight sm:block">
        {profile.name}
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-full px-3.5 py-2 text-[13px] font-medium transition-colors",
              isActive(item.href)
                ? "bg-muted text-foreground"
                : "text-muted-foreground hover:text-foreground",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <button
        id="theme-toggle"
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-full text-foreground transition-colors hover:bg-muted"
        aria-label="Switch to dark mode"
      >
        <span id="icon-sun" class="hidden">
          <Icon name="Sun" class="h-5 w-5" />
        </span>
        <span id="icon-moon">
          <Icon name="Moon" class="h-5 w-5" />
        </span>
      </button>
      <a
        href="/contact"
        class="hidden rounded-full bg-primary px-4 py-2 text-[13px] font-semibold text-primary-foreground transition-all hover:brightness-110 active:scale-95 sm:inline-flex"
      >
        Hire me
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="flex h-9 w-9 items-center justify-center rounded-full text-foreground hover:bg-muted md:hidden"
        aria-label="Menu"
        aria-expanded="false"
      >
        <span id="icon-menu">
          <Icon name="Menu" class="h-5 w-5" />
        </span>
        <span id="icon-close" class="hidden">
          <Icon name="X" class="h-5 w-5" />
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="glass hidden border-t border-border/60 md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-3">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "mobile-link rounded-xl px-4 py-2.5 text-[15px] font-medium hover:bg-muted",
              isActive(item.href) ? "bg-muted text-foreground" : "text-foreground",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="mobile-link mt-1 flex items-center justify-center rounded-xl bg-primary px-4 py-3 text-[15px] font-semibold text-primary-foreground"
      >
        Hire me
      </a>
    </nav>
  </div>
</header>
