---
import Icon from "./Icon.astro";
import { services } from "../data/site";
---

<section id="services" class="bg-surface-2 border-y border-border">
  <div class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-36">
    <div class="max-w-2xl">
      <p class="text-[13px] font-semibold uppercase tracking-wider text-primary">Services</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-[-0.02em] md:text-5xl">
        How I can help your product
      </h1>
      <p class="mt-3 text-lg text-muted-foreground">
        Four disciplines. One coherent system. From MVP to production-ready platforms.
      </p>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-2">
      {
        services.map((service, index) => (
          <div
            data-reveal
            data-delay={String((index % 2) * 0.08)}
            class="group rounded-3xl border border-border/70 bg-card p-8 transition-all hover:elevation-3"
          >
            <div class="flex items-start gap-4">
              <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-primary-container transition-transform group-hover:scale-105">
                <Icon name={service.icon} class="h-6 w-6 text-on-primary-container" />
              </div>
              <div>
                <h3 class="text-lg font-semibold tracking-tight">{service.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{service.desc}</p>
              </div>
            </div>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {service.points.map((point) => (
                <span class="rounded-lg bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground">
                  {point}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
