---
import Icon from "./Icon.astro";
import { skills } from "../data/site";
---

<section id="about" class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-36">
  <div class="grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <p
        data-reveal
        class="text-[13px] font-semibold uppercase tracking-wider text-primary"
      >
        About
      </p>
      <h1
        data-reveal
        data-delay="0.05"
        class="mt-3 text-3xl font-semibold tracking-[-0.02em] md:text-5xl md:leading-[1.05]"
      >
        Software that's easy to extend, maintain, and trust in production.
      </h1>
    </div>
    <div class="md:col-span-7">
      <div
        data-reveal
        data-delay="0.1"
        class="space-y-4 text-lg leading-relaxed text-muted-foreground"
      >
        <p>
          For 5+ years I've shipped full-stack apps: Next.js + TypeScript on the front,
          Supabase/Postgres and APIs behind it, Stripe for billing, deployed and live on
          Vercel. Founders hire me when they need a product that stays up, converts, and
          scales cleanly as they grow.
        </p>
        <p>
          I avoid "prompt and polish" development — critical decisions around system
          design, performance, and data modeling are always made deliberately. I own
          features end-to-end, from UI implementation and frontend architecture to API
          integration and deployment.
        </p>
      </div>
    </div>
  </div>

  <div class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      skills.map((skill, index) => (
        <div
          data-reveal
          data-delay={String(index * 0.07)}
          class="rounded-2xl border border-border/70 bg-card p-6 transition-all hover:elevation-2"
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary-container">
            <Icon name={skill.icon} class="h-5 w-5 text-on-primary-container" />
          </div>
          <h3 class="mt-4 font-semibold tracking-tight">{skill.title}</h3>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {skill.items.map((item) => (
              <span class="rounded-lg bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
