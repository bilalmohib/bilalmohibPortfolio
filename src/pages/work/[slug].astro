---
import PageShell from "../../components/PageShell.astro";
import BrowserPreview from "../../components/BrowserPreview.astro";
import Icon from "../../components/Icon.astro";
import { work, type Project } from "../../data/site";

export function getStaticPaths() {
  return work.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const others = work.filter((item) => item.slug !== project.slug).slice(0, 3);
---

<PageShell
  title={`${project.title} — Bilal Mohib`}
  description={project.summary}
>
  <article class="mx-auto max-w-6xl px-5 pb-24 pt-16 md:px-8 md:pb-36 md:pt-24">
    <a
      href="/work"
      class="inline-flex items-center gap-2 text-sm font-medium text-muted-foreground hover:text-foreground"
    >
      ← All work
    </a>

    <p class="mt-8 text-[13px] font-semibold uppercase tracking-wider text-primary">
      {project.client}
    </p>
    <h1 class="mt-3 max-w-4xl text-3xl font-semibold tracking-[-0.02em] md:text-6xl md:leading-[1.05]">
      {project.title}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">
      {project.summary}
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      {
        project.url && (
          <a
            href={project.url}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground hover:brightness-110"
          >
            Open live site
            <Icon name="ExternalLink" class="h-4 w-4" />
          </a>
        )
      }
      <a
        href="/contact"
        class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-semibold hover:bg-muted"
      >
        Start a similar project
      </a>
    </div>

    {
      project.preview && project.url && (
        <div class="mt-12">
          <BrowserPreview
            src={project.preview}
            url={project.url}
            alt={`${project.title} live preview`}
            href={project.url}
            large
          />
          <p class="mt-3 text-center text-sm text-muted-foreground">
            Live snapshot of {project.url.replace(/^https?:\/\//, "").replace(/\/$/, "")} —
            click to open the production site.
          </p>
        </div>
      )
    }

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      <div class="rounded-2xl border border-border/70 bg-card p-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Role</p>
        <p class="mt-2 text-sm leading-relaxed">{project.role || "Full-stack engineering"}</p>
      </div>
      <div class="rounded-2xl border border-border/70 bg-card p-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Period</p>
        <p class="mt-2 text-sm leading-relaxed">{project.period}</p>
      </div>
      <div class="rounded-2xl border border-border/70 bg-card p-6">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Stack</p>
        <div class="mt-2 flex flex-wrap gap-1.5">
          {
            project.stack.map((tech) => (
              <span class="rounded-lg bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                {tech}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    {
      (project.problem || project.solution || project.outcome) && (
        <div class="mt-14 grid gap-6 md:grid-cols-3">
          {project.problem && (
            <div>
              <h2 class="text-lg font-semibold">The problem</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{project.problem}</p>
            </div>
          )}
          {project.solution && (
            <div>
              <h2 class="text-lg font-semibold">What I built</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{project.solution}</p>
            </div>
          )}
          {project.outcome && (
            <div>
              <h2 class="text-lg font-semibold">The result</h2>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{project.outcome}</p>
            </div>
          )}
        </div>
      )
    }

    {
      project.highlights && (
        <div class="mt-14">
          <h2 class="text-lg font-semibold">What clients notice</h2>
          <ul class="mt-4 grid gap-3 md:grid-cols-2">
            {project.highlights.map((item) => (
              <li class="flex gap-3 rounded-2xl border border-border/70 bg-card p-4 text-sm leading-relaxed">
                <Icon name="CircleCheck" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                {item}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-16 flex flex-col items-start justify-between gap-4 rounded-[2rem] border border-border/70 bg-card p-8 md:flex-row md:items-center">
      <div>
        <h2 class="text-xl font-semibold">Want a site that looks this sharp?</h2>
        <p class="mt-1 text-sm text-muted-foreground">
          I build production marketing sites and SaaS products end to end.
        </p>
      </div>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground hover:brightness-110"
      >
        Hire me
        <Icon name="ArrowRight" class="h-4 w-4" />
      </a>
    </div>

    <h2 class="mt-16 text-lg font-semibold">More work</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {
        others.map((item) => (
          <a
            href={`/work/${item.slug}`}
            class="rounded-2xl border border-border/70 bg-card p-5 transition-all hover:-translate-y-1 hover:elevation-2"
          >
            <p class="text-xs text-muted-foreground">{item.client}</p>
            <h3 class="mt-1 font-semibold leading-snug">{item.title}</h3>
          </a>
        ))
      }
    </div>
  </article>
</PageShell>
