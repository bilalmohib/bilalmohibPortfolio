---
import PageShell from "../components/PageShell.astro";
import Hero from "../components/Hero.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import Icon from "../components/Icon.astro";
import { services } from "../data/site";
---

<PageShell>
  <Hero />
  <FeaturedWork />

  <section class="bg-surface-2 border-y border-border">
    <div class="mx-auto max-w-6xl px-5 py-24 md:px-8 md:py-32">
      <div class="max-w-2xl">
        <p class="text-[13px] font-semibold uppercase tracking-wider text-primary">Services</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-0.02em] md:text-5xl">
          How I can help your product
        </h2>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        {
          services.map((service) => (
            <div class="rounded-3xl border border-border/70 bg-card p-8">
              <h3 class="text-lg font-semibold tracking-tight">{service.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{service.desc}</p>
            </div>
          ))
        }
      </div>
      <a
        href="/services"
        class="mt-8 inline-flex items-center gap-2 text-[15px] font-semibold text-primary hover:underline"
      >
        All services
        <Icon name="ArrowRight" class="h-4 w-4" />
      </a>
    </div>
  </section>

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 hero-glow opacity-60"></div>
    <div class="mx-auto max-w-6xl px-5 py-24 text-center md:px-8 md:py-32">
      <p class="text-[13px] font-semibold uppercase tracking-wider text-primary">Contact</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-0.02em] md:text-5xl">
        Let's build something.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted-foreground">
        Tell me what you're building. I'll read it and respond directly — no account
        managers, no templates.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-[15px] font-semibold text-primary-foreground hover:brightness-110"
      >
        Start a project
        <Icon name="ArrowRight" class="h-4 w-4" />
      </a>
    </div>
  </section>
</PageShell>
